<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}
    <title>
      {{- page_title -}}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}
    {{ content_for_header }}
    {% style %}
      :root {
        --hi-bg: {{ settings.color_background }};
        --hi-surface: {{ settings.color_surface }};
        --hi-ink: {{ settings.color_ink }};
        --hi-muted: {{ settings.color_muted }};
        --hi-accent: {{ settings.color_accent }};
      }
    {% endstyle %}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    <script>
      window.HI_ROUTES = {
        cart_url: {{ routes.cart_url | json }},
        cart_add_url: {{ routes.cart_add_url | json }},
        cart_change_url: {{ routes.cart_change_url | json }},
        cart_update_url: {{ routes.cart_update_url | json }}
      };
    </script>
    <script src="{{ 'haptics.js' | asset_url }}" defer></script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </head>
  <body>
    <a class="hi-skip" href="#MainContent">{{ 'general.skip_to_content' | t }}</a>
    {% section 'header' %}
    <main id="MainContent" class="hi-main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>
    {% section 'footer' %}
    {% section 'cart-drawer' %}
  </body>
</html>
