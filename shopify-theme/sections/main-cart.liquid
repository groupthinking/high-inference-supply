<section class="hi-section">
  <div class="hi-wrap hi-wrap--narrow">
    <h1 class="hi-section__title">{{ 'cart.title' | t }}</h1>

    {%- if cart.item_count == 0 -%}
      <div class="hi-empty">
        <p>{{ 'cart.empty' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="hi-btn hi-btn--solid">
          {{ 'general.continue_shopping' | t }}
        </a>
      </div>
    {%- else -%}
      {%- form 'cart', cart, id: 'hi-cart-form', class: 'hi-cart-form' -%}
        <ul class="hi-cart-list">
          {%- for item in cart.items -%}
            <li class="hi-cart-item">
              {%- if item.image -%}
                <a href="{{ item.url }}" class="hi-cart-item__media">
                  {{ item.image | image_url: width: 200 | image_tag: class: 'hi-cart-item__img', loading: 'lazy' }}
                </a>
              {%- endif -%}
              <div class="hi-cart-item__body">
                <a href="{{ item.url }}" class="hi-cart-item__title">{{ item.product.title | escape }}</a>
                {%- unless item.product.has_only_default_variant -%}
                  <p class="hi-cart-item__variant">{{ item.variant.title | escape }}</p>
                {%- endunless -%}
                <p class="hi-cart-item__price">{{ item.final_line_price | money }}</p>
                <div class="hi-cart-item__controls">
                  <input
                    type="number"
                    name="updates[]"
                    value="{{ item.quantity }}"
                    min="0"
                    aria-label="{{ item.product.title | escape }}"
                    class="hi-qty-input"
                  >
                  <a href="{{ item.url_to_remove }}" class="hi-link">{{ 'cart.remove' | t }}</a>
                </div>
              </div>
            </li>
          {%- endfor -%}
        </ul>

        <div class="hi-cart-summary">
          <div class="hi-cart-summary__row">
            <span>{{ 'cart.subtotal' | t }}</span>
            <strong>{{ cart.total_price | money }}</strong>
          </div>
          <p class="hi-cart-summary__note">{{ 'cart.shipping_note' | t }}</p>
          <div class="hi-cart-summary__actions">
            <button type="submit" name="update" class="hi-btn hi-btn--outline">{{ 'cart.update' | t }}</button>
            <button type="submit" name="checkout" class="hi-btn hi-btn--solid">{{ 'cart.checkout' | t }}</button>
          </div>
        </div>
      {%- endform -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main_cart.name",
  "settings": []
}
{% endschema %}
