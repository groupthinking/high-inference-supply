<section class="hi-hero">
  <div class="hi-wrap hi-hero__grid">
    <div class="hi-hero__copy">
      {%- if section.settings.kicker != blank -%}
        <p class="hi-kicker">{{ section.settings.kicker | escape }}</p>
      {%- endif -%}
      <h1 class="hi-hero__title">{{ section.settings.heading | escape }}</h1>
      {%- if section.settings.subheading != blank -%}
        <p class="hi-hero__sub">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}" class="hi-btn hi-btn--solid">
          {{ section.settings.cta_label | escape }}
        </a>
      {%- endif -%}
    </div>

    {%- if section.settings.image != blank -%}
      <div class="hi-hero__media">
        {{ section.settings.image | image_url: width: 1200 | image_tag: class: 'hi-hero__img', fetchpriority: 'high', widths: '600, 900, 1200', sizes: '(max-width: 900px) 100vw, 50vw' }}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.hero.name",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.hero.kicker",
      "default": "Edition 01"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.hero.heading",
      "default": "High Inference"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "t:sections.hero.subheading",
      "default": "Heavyweight garment-dyed apparel and small-batch hardware produced with verified US fulfillment partners."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:sections.hero.cta_label",
      "default": "Shop catalog"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "t:sections.hero.cta_link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.hero.image"
    }
  ],
  "presets": [
    {
      "name": "t:sections.hero.name"
    }
  ]
}
{% endschema %}
