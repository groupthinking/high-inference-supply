{%- assign target_collection = section.settings.collection | default: collections.all -%}

<section class="hi-section">
  <div class="hi-wrap">
    {%- if section.settings.heading != blank -%}
      <div class="hi-section__head">
        <h2 class="hi-section__title">{{ section.settings.heading | escape }}</h2>
        {%- if target_collection != blank -%}
          <a href="{{ target_collection.url }}" class="hi-link">{{ 'general.continue_shopping' | t }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if target_collection != blank and target_collection.products_count > 0 -%}
      <div class="hi-grid">
        {%- for product in target_collection.products limit: section.settings.limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="hi-empty">
        <h3>{{ 'products.no_products_title' | t }}</h3>
        <p>{{ 'products.no_products_body' | t }}</p>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.featured_collection.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.featured_collection.heading",
      "default": "Catalog"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.featured_collection.collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "t:sections.featured_collection.limit",
      "min": 2,
      "max": 24,
      "step": 2,
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured_collection.name"
    }
  ]
}
{% endschema %}
