<section class="hi-section">
  <div class="hi-wrap hi-wrap--narrow">
    <h1 class="hi-section__title">{{ 'general.not_found_title' | t }}</h1>
    <p class="hi-hero__sub">{{ 'general.not_found_body' | t }}</p>
    <a href="{{ routes.all_products_collection_url }}" class="hi-btn hi-btn--solid">
      {{ 'general.continue_shopping' | t }}
